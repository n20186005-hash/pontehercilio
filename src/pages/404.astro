---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página não encontrada | Guia Ponte Hercílio Luz" description="Página não encontrada." path="/404/" noindex={true}>
  <section class="container-shell flex min-h-[70vh] flex-col justify-center pt-28 pb-20">
    <p class="eyebrow">Erro 404</p><h1 class="mt-4 font-[Georgia] text-5xl text-white md:text-7xl">Esta rota não cruza a ponte.</h1><p class="mt-5 max-w-xl text-lg leading-8 text-slate-400">Volte ao guia principal para continuar o passeio por Florianópolis.</p><a href="/" class="mt-8 inline-flex w-fit rounded-full bg-[#d68b46] px-5 py-3 font-bold text-[#07141d] no-underline">Voltar ao início</a>
  </section>
</BaseLayout>
