---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAPS_URL, PLUS_CODE, withSiteName } from '../data/site';
import { attractionSchema, breadcrumbSchema, faqSchema, webPageSchema } from '../lib/schema';

const pageTitle = 'Como chegar';
const pageDescription = 'Como chegar à Ponte Hercílio Luz, no Centro de Florianópolis: a pé pelo Centro Histórico, de ônibus até o TICEN, de bicicleta, de carro com opções de estacionamento e pelo lado continental, no Estreito.';
const pagePath = '/como-chegar/';

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';

const modes = [
  ['A pé pelo Centro', 'O caminho mais interessante. Do Mercado Público e da Praça XV, siga pela Rua Felipe Schmidt em direção à baía até o Parque da Luz, na cabeceira insular da ponte.'],
  ['De ônibus', 'Linhas urbanas com destino ao Centro e ao terminal TICEN deixam o visitante a poucos minutos da cabeceira. Do terminal, o trajeto até a ponte é curto e totalmente plano na maior parte.'],
  ['De bicicleta', 'A orla da Beira-Mar Norte e os eixos do Centro permitem integrar a ponte a um passeio ciclável. Respeite a sinalização e a prioridade de pedestres na passarela.'],
  ['De carro ou aplicativo', 'Para visita turística, o mais simples é estacionar no Centro e seguir a pé. Vagas na rua junto à cabeceira são escassas e disputadas.'],
  ['Táxi e aplicativos', 'Chegam até o Parque da Luz e até a orla do Estreito, no lado continental. Combine o ponto de desembarque com o início do roteiro desejado.'],
  ['Pelo continente', 'O acesso pelo Estreito começa pela orla, nas proximidades do Forte Santana — opção recomendada para quem chega pela BR-101 ou pelo bairro e quer ver a ponte de frente.'],
];

const walk = [
  'Comece no Mercado Público de Florianópolis, ponto de referência do Centro Histórico.',
  'Atravesse a Praça XV de Novembro e siga pela Rua Felipe Schmidt, um dos eixos tradicionais do Centro.',
  'Continue em direção à baía Sul até chegar ao Parque da Luz, na cabeceira insular.',
  'Use o mirante do parque para o primeiro enquadramento frontal da ponte.',
  'Entre na passarela e atravesse; no lado continental, a orla do Estreito e o Forte Santana completam o passeio.',
];

const faq = [
  { q: 'Como chegar à Ponte Hercílio Luz de ônibus?', a: 'Use as linhas urbanas com destino ao Centro e ao terminal TICEN. Do terminal, siga pela Rua Felipe Schmidt até o Parque da Luz: a caminhada é curta e leva poucos minutos. Consulte o sistema de transporte municipal para escolher a linha mais direta a partir do seu bairro.' },
  { q: 'Dá para ir a pé do Mercado Público até a ponte?', a: 'Sim. O trajeto é praticamente plano e acompanha o Centro Histórico pela Rua Felipe Schmidt até o Parque da Luz, na cabeceira insular. Em ritmo tranquilo, são cerca de 10 a 15 minutos de caminhada — estimativa deste guia, que varia conforme paradas e movimento.' },
  { q: 'Onde estacionar para visitar a ponte?', a: 'O entorno imediato tem vagas limitadas na rua. Prefira estacionamentos privados rotativos do Centro e caminhe os últimos minutos. Pelo lado continental, as proximidades da orla do Estreito e do Forte Santana também funcionam como ponto de partida.' },
  { q: 'Como chegar do aeroporto de Florianópolis?', a: 'O Aeroporto Internacional Hercílio Luz fica na porção sul da Ilha de Santa Catarina. De carro ou aplicativo, siga em direção ao Centro; também há integração de ônibus urbanos com o terminal TICEN. Reserve tempo extra em horários de pico e na alta temporada.' },
  { q: 'Qual é o melhor acesso: pela ilha ou pelo continente?', a: 'Pela ilha, o acesso natural é o Parque da Luz, com mirante e enquadramento frontal. Pelo continente, a orla do Estreito e o entorno do Forte Santana oferecem a vista da estrutura por baixo e o pôr do sol com a ponte ao fundo. Se tiver tempo, combine os dois lados na mesma visita.' },
  { q: 'O acesso é indicado para pessoas com mobilidade reduzida?', a: 'Os acessos seguem padrões urbanos e o percurso é plano na maior parte, mas a travessia é longa (cerca de 821 m) e exposta a vento e sol. Avalie as condições do dia e consulte os canais oficiais para orientações específicas de acessibilidade.' },
];

const schema = [
  attractionSchema(siteOrigin),
  webPageSchema(siteOrigin, pagePath, withSiteName(pageTitle), pageDescription),
  breadcrumbSchema(siteOrigin, [
    { name: 'Início', path: '/' },
    { name: pageTitle, path: pagePath }
  ]),
  faqSchema(faq),
];
---

<BaseLayout
  title={withSiteName(pageTitle)}
  description={pageDescription}
  path={pagePath}
  schema={schema}
>
  <section class="container-shell pt-36 pb-16">
    <nav aria-label="Trilha de navegação" class="text-xs uppercase tracking-[.16em] text-slate-500">
      <ol class="flex flex-wrap items-center gap-x-2">
        <li><a class="hover:text-white" href="/">Início</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-300">Como chegar</li>
      </ol>
    </nav>
    <h1 class="mt-6 max-w-4xl font-[Georgia] text-4xl leading-tight text-white md:text-6xl">Como chegar à Ponte Hercílio Luz, no Centro de Florianópolis</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">A ponte liga a Ilha de Santa Catarina ao continente no Centro da capital catarinense. Os dois acessos mais usados são a cabeceira insular, pelo <strong class="text-white">Parque da Luz</strong>, e a cabeceira continental, pela orla do <strong class="text-white">Estreito</strong>. A escolha depende de onde você está e de como quer começar o passeio.</p>
  </section>

  <section class="border-y border-white/10 bg-[#081721] py-20">
    <div class="container-shell">
      <p class="eyebrow">Por modo de transporte</p>
      <h2 class="mt-4 font-[Georgia] text-3xl text-white md:text-4xl">Seis formas de chegar</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {modes.map(([title, text]) => (
          <article class="panel rounded-3xl p-7">
            <h3 class="text-xl font-semibold text-white">{title}</h3>
            <p class="mt-3 leading-7 text-slate-400">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-shell grid gap-12 lg:grid-cols-[.95fr_1.05fr]">
      <div>
        <p class="eyebrow">Roteiro a pé</p>
        <h2 class="mt-4 font-[Georgia] text-3xl text-white md:text-4xl">Do Mercado Público à passarela</h2>
        <p class="mt-6 leading-8 text-slate-300">O percurso a pé pelo Centro é, para muitos visitantes, a melhor parte do passeio: concentra patrimônio, comércio tradicional e a aproximação gradual da estrutura.</p>
        <p class="mt-5 leading-8 text-slate-400">Todo o trajeto é urbano, com calçadas e travessias sinalizadas, e pode ser feito em qualquer ordem — inclusive no sentido inverso, começando pelo continente.</p>
        <a href={MAPS_URL} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-bold text-[#07141d] no-underline">Abrir no Google Maps ↗</a>
      </div>
      <ol class="space-y-4">
        {walk.map((step, i) => (
          <li class="flex gap-4 rounded-2xl border border-white/10 bg-black/20 p-5">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#d68b46]/50 text-sm font-bold text-[#e3a86f]">{i + 1}</span>
            <p class="text-sm leading-7 text-slate-300">{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#07141d] py-20">
    <div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="eyebrow">Referências do endereço</p>
        <h2 class="mt-4 font-[Georgia] text-3xl text-white md:text-4xl">Endereço, Plus Code e coordenadas</h2>
        <p class="mt-6 leading-8 text-slate-400">Use os dados abaixo em aplicativos de navegação. Para quem vem de carro, o ponto mais prático é definir um estacionamento no Centro antes de seguir a pé.</p>
      </div>
      <dl class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-3xl border border-white/10 bg-black/20 p-6"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Endereço de referência</dt><dd class="mt-2 text-base leading-7 text-slate-200">Ponte pênsil - Centro, Florianópolis - SC, 88010-400</dd></div>
        <div class="rounded-3xl border border-white/10 bg-black/20 p-6"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Plus Code</dt><dd class="mt-2 text-base leading-7 text-slate-200">{PLUS_CODE}</dd></div>
        <div class="rounded-3xl border border-white/10 bg-black/20 p-6"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Cabeceira insular</dt><dd class="mt-2 text-base leading-7 text-slate-200">Parque da Luz, fim da Rua Felipe Schmidt</dd></div>
        <div class="rounded-3xl border border-white/10 bg-black/20 p-6"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Cabeceira continental</dt><dd class="mt-2 text-base leading-7 text-slate-200">Orla do Estreito, próximo ao Forte Santana</dd></div>
      </dl>
    </div>
  </section>

  <section class="py-20">
    <div class="container-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Perguntas frequentes</p>
        <h2 class="mt-4 font-[Georgia] text-3xl text-white md:text-4xl">FAQ de acesso</h2>
      </div>
      <div class="mt-10 divide-y divide-white/10 border-y border-white/10">
        {faq.map((item) => <details class="group py-5"><summary class="cursor-pointer list-none pr-8 text-lg font-semibold text-white">{item.q}<span class="float-right text-[#e3a86f] group-open:rotate-45">+</span></summary><p class="mt-3 max-w-3xl leading-7 text-slate-400">{item.a}</p></details>)}
      </div>
      <p class="mt-8 rounded-2xl border border-white/10 bg-white/[.03] px-5 py-4 text-xs leading-6 text-slate-500">Tempos e distâncias são estimativas deste guia e variam com trânsito, movimento e paradas ao longo do caminho. Este projeto é independente, sem fins lucrativos e não indica estabelecimentos específicos.</p>
      <div class="mt-10 flex flex-wrap gap-4 text-sm">
        <a href="/horarios/" class="rounded-full border border-[#d68b46] px-5 py-3 font-bold text-[#efbd8d] no-underline hover:bg-[#d68b46] hover:text-[#07141d]">Horários e circulação →</a>
        <a href="/historia/" class="rounded-full border border-white/15 px-5 py-3 font-bold text-slate-200 no-underline hover:border-[#d68b46]">História e engenharia →</a>
      </div>
    </div>
  </section>
</BaseLayout>
