---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';

// ---- Fatos rápidos (faixa sob o herói) ----
const facts = [
  ['821 m', 'extensão aproximada'],
  ['339,5 m', 'vão central pênsil'],
  ['1926', 'ano de inauguração'],
  ['2019', 'reabertura após restauração'],
];

// ---- Linha do tempo (História) ----
const timeline = [
  ['1922', '14 de novembro: início das obras da travessia entre ilha e continente.'],
  ['1924', 'Morte do governador Hercílio Luz, idealizador do projeto, dois anos antes da inauguração.'],
  ['1926', '13 de maio: inauguração. Até 1935, a travessia chegou a ser cobrada (1 tostão).'],
  ['1969', 'O tabuleiro original de madeira recebe revestimento asfáltico, aumentando o peso da estrutura.'],
  ['1975', 'Inauguração da Ponte Colombo Salles encerra o período em que a Hercílio Luz era a única ligação rodoviária.'],
  ['1982', 'Primeira interdição total para veículos, após fissuras detectadas nas barras de olhal em 1981.'],
  ['1988', 'Reabertura parcial: pedestres, ciclistas e motociclistas voltam a cruzar.'],
  ['1991', 'Nova interdição; o asfalto é removido para aliviar o peso sobre a estrutura centenária.'],
  ['1998', 'Tombamento federal pelo Iphan, somando-se às proteções municipal (1992) e estadual (1997).'],
  ['2019', '30 de dezembro: reabertura completa após a grande restauração.'],
  ['2024', 'Entra em operação a iluminação cênica que valoriza a ponte à noite.'],
  ['2026', 'Centenário da travessia: 100 anos como símbolo de Florianópolis e de Santa Catarina.'],
];

// ---- Números técnicos (Engenharia) ----
const stats = [
  ['821 m', 'extensão total da ponte'],
  ['339,5 m', 'vão central pênsil'],
  ['74 m', 'altura das torres'],
  ['30,8 m', 'altura média do tabuleiro sobre o mar'],
  ['≈ 5.000 t', 'peso da estrutura de aço'],
  ['14.250 m³', 'concreto em fundações e pilares'],
  ['4.000 tf', 'capacidade das correntes de barras de olhal'],
  ['1926 · 2019', 'inauguração · reabertura após restauro'],
];

// ---- Roteiro sugerido (Visita) ----
const roteiro = [
  'Comece pelo Centro Histórico: Mercado Público, Largo da Alfândega e Praça XV ajudam a entender a cidade que a ponte ligou ao continente.',
  'Suba a Rua Felipe Schmidt em direção à baía e entre no Parque da Luz, na cabeceira insular.',
  'Do mirante do parque, aproveite o enquadramento frontal da ponte para fotografar torres e vão pênsil.',
  'Atravesse a pé (ou de bicicleta), observando as correntes de barras de olhal e a estrutura acima da água.',
  'No lado continental, o entorno do Forte Santana e a orla oferecem o pôr do sol com a silhueta da ponte ao fundo. Retorne antes de escurecer, se quiser ver a iluminação cênica ligar.',
];

// ---- Serviços e infraestrutura no entorno (neutro, sem indicação comercial) ----
const facilities = [
  ['Banheiros públicos', 'Banheiros', 'Não há sanitários fixos ao longo da passarela. Use os banheiros de equipamentos públicos do Centro, do Mercado Público e de estabelecimentos comerciais antes de atravessar — e planeje também o retorno.'],
  ['Estacionamento', 'Estacionamento', 'Vagas na rua são escassas e disputadas no entorno imediato. Prefira estacionamentos privados rotativos do Centro e da orla, a 5–10 minutos a pé da cabeceira insular.'],
  ['Alimentação', 'Restaurantes', 'No Centro você encontra cozinha brasileira e frutos do mar, parrillas e churrascarias, restaurantes com vista para a baía e opções de refeição rápida. Verifique horários e reservas diretamente com cada casa.'],
  ['Café e lanches', 'Cafés e padarias', 'Cafeterias, padarias e confeitarias ao redor do Centro são boas paradas para café, lanche e doces regionais antes ou depois da travessia.'],
  ['Compras', 'Mercados e conveniência', 'Mercados de bairro, minimercados e lojas de conveniência no Centro vendem água, lanches e itens de uso imediato. No Mercado Público, encontram-se produtos locais e artesanato.'],
  ['Onde dormir', 'Hospedagem', 'Hotéis do Centro concentram-se perto dos principais pontos turísticos; pousadas na ilha e no continente ampliam as opções. Em alta temporada, reserve com antecedência.'],
  ['Abastecimento', 'Combustível e recarga', 'Postos de combustível ficam nas avenidas de acesso ao Centro e no lado continental (Estreito). Pontos de recarga para veículos elétricos estão em postos e shoppings do município.'],
  ['Saúde', 'Farmácia e emergência', 'Farmácias no Centro funcionam em horário comercial e em regime de plantão. Em emergências, acione o SAMU (192) ou o Corpo de Bombeiros (193) e siga a orientação do serviço público mais próximo.'],
  ['Pagamento', 'Dinheiro e cartões', 'Agências bancárias e caixas eletrônicos existem no Centro; cartões são amplamente aceitos, mas leve dinheiro trocado para pequenos comércios e estacionamentos rotativos.'],
  ['Como se deslocar', 'Transporte público', 'Ônibus urbanos com integração ao terminal TICEN, táxis e aplicativos de mobilidade conectam o Centro aos bairros da ilha e ao continente. A pé, tudo fica a poucos minutos da cabeceira.'],
];

// ---- Histórias e curiosidades ----
const stories = [
  ['Memória', 'Uma ponte com nome de governador', 'Idealizada por Hercílio Luz, o "pai das estradas" de Santa Catarina, a travessia foi viabilizada durante seu governo. Ele morreu em 1924, sem ver a obra pronta — e a ponte recebeu seu nome em homenagem.'],
  ['Curiosidade', 'O pedágio de 1 tostão', 'Entre 1926 e 1935, atravessar a ponte custava 1 tostão (100 réis). O pedágio ajudava a pagar o financiamento obtido nos Estados Unidos, quitado somente em 1978.'],
  ['Engenharia', 'A maior ponte pênsil do Brasil', 'Com 339,5 m de vão central e correntes de barras de olhal, é a maior ponte pênsil do país e um dos maiores exemplos vivos de ponte suspensa por barras de olhal ainda em uso no mundo.'],
  ['Alerta', 'A lição da Silver Bridge', 'Erguida pela mesma construtora da Silver Bridge americana — que desabou em 1967 causando 46 mortes —, a Hercílio Luz passou a ser monitorada de perto. Fissuras nas barras detectadas em 1981 levaram à interdição de 1982.'],
  ['Restauração', 'A ponte que "andou" alguns centímetros', 'Durante o restauro, em 2017, dezenas de macacos hidráulicos ergueram o vão pênsil em etapas para permitir a troca de componentes da cadeia de suspensão — uma operação delicada e rara em pontes desse tipo.'],
  ['Símbolo', 'A imagem mais citada do estado', 'Pesquisas de opinião apontam a ponte como o símbolo mais lembrado de Florianópolis — muitas vezes citado até antes das praias catarinenses. Ela estampa camisas de clubes, marcas, novelas e o imaginário de quem chega à ilha.'],
];

const faq = [
  { q: 'A Ponte Hercílio Luz é paga?', a: 'Não há cobrança de ingresso para caminhar e apreciar a ponte como espaço público. Serviços privados no entorno, estacionamento e transporte têm tarifas próprias.' },
  { q: 'Qual é o melhor horário para visitar?', a: 'O fim da tarde combina luz favorável para fotografia com a transição para a iluminação cênica. Em fins de semana e feriados, a experiência costuma ser mais voltada a pedestres e ciclistas, mas alterações temporárias podem ocorrer.' },
  { q: 'Quanto tempo reservar?', a: 'Para atravessar com calma, fotografar e visitar o Parque da Luz, reserve aproximadamente 1 a 2 horas. Um roteiro com Mercado Público e Centro Histórico pode ocupar meio período.' },
  { q: 'É possível atravessar de bicicleta?', a: 'Sim, há circulação de ciclistas, sujeita à sinalização e a eventuais restrições operacionais em eventos ou manutenção.' },
  { q: 'Carros podem passar pela ponte?', a: 'Nos dias úteis há circulação veicular conforme as regras operacionais vigentes. Fins de semana e feriados tradicionalmente privilegiam pedestres e ciclistas. Consulte avisos do Governo de Santa Catarina antes da viagem, pois eventos e manutenção podem alterar o fluxo.' },
  { q: 'Há banheiros públicos na ponte?', a: 'Não existem sanitários fixos ao longo da passarela. Planeje o trajeto usando os banheiros de equipamentos e estabelecimentos do Centro (como o Mercado Público e centros comerciais) antes de atravessar.' },
  { q: 'A visita é acessível para pessoas com mobilidade reduzida?', a: 'A travessia é longa, plana na maior parte do percurso e exposta ao sol e ao vento. Os acessos seguem padrões urbanos, mas convém avaliar o percurso e as condições do dia e consultar os canais oficiais para orientação específica.' },
  { q: 'Posso levar meu animal de estimação?', a: 'Espaços públicos do entorno costumam aceitar animais guiados por coleira. Como a passarela é exposta, leve água, proteja as patas do piso quente e respeite a sinalização; regras operacionais podem mudar, então confira os avisos oficiais.' },
  { q: 'É permitido usar drone para fotografar?', a: 'A operação de drones em área urbana e sobre bem tombado exige autorização dos órgãos competentes (ANAC, DECEA e restrições locais/federais). Este guia não recomenda voos sem licença e não fornece instruções de operação.' },
  { q: 'A ponte fica iluminada à noite?', a: 'Desde o fim de 2024, a iluminação cênica valoriza a estrutura durante a noite e costuma ser o ponto alto da vista depois do pôr do sol. Confirme o funcionamento no dia da visita, pois manutenções eventuais podem apagar o espetáculo.' },
  { q: 'Qual é a melhor época do ano?', a: 'Florianópolis tem clima subtropical: verões quentes com chuvas frequentes e invernos amenos. Primavera e outono costumam reunir temperaturas agradáveis; consulte a seção Clima e prefira dias secos para atravessar a pé.' },
  { q: 'Onde conseguir as melhores fotos?', a: 'O Parque da Luz e o mirante da cabeceira insular oferecem enquadramentos frontais; a orla e o entorno do Forte Santana ajudam a registrar a estrutura por baixo e em perspectiva lateral. Ao entardecer, a luz dourada valoriza o aço oxidado.' },
];

const MAPS_URL = 'https://maps.app.goo.gl/NTxFSZTyTbenYDZo6';
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteOrigin}/#attraction`,
  name: 'Ponte Hercílio Luz',
  alternateName: ['Ponte pênsil Hercílio Luz', 'Ponte Hercílio Luz de Florianópolis'],
  description: 'Ponte pênsil histórica no Centro de Florianópolis, em Santa Catarina (Brasil): símbolo do estado, patrimônio cultural brasileiro e um dos maiores exemplos de ponte suspensa por barras de olhal ainda em uso no mundo.',
  url: `${siteOrigin}/`,
  image: [`${siteOrigin}/images/ponte-hercilio-luz-hero.jpg`],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ponte pênsil - Centro',
    addressLocality: 'Florianópolis',
    addressRegion: 'SC',
    postalCode: '88010-400',
    addressCountry: 'BR'
  },
  geo: { '@type': 'GeoCoordinates', latitude: -27.593811676247984, longitude: -48.56768502278584 },
  hasMap: MAPS_URL,
  openingHours: 'Acesso para visitação e travessia de pedestres sujeito às regras operacionais e a interdições temporárias; consulte os canais oficiais antes da visita.',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.8', reviewCount: '24497', bestRating: '5' },
  isAccessibleForFree: true,
  sameAs: [
    'https://www.gov.br/iphan/pt-br/assuntos/noticias/ponte-hercilio-luz-chega-aos-100-anos-como-simbolo-de-santa-catarina',
    'https://www.sc.gov.br/vivaaponte/',
    'https://redeplanejamento.pmf.sc.gov.br/pt-BR/projetos/ponte-viva',
    'https://www.santur.sc.gov.br/',
    MAPS_URL
  ]
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};
---

<BaseLayout
  title="Ponte Hercílio Luz (Florianópolis) | História, Visita e Guia"
  description="Guia independente em português sobre a Ponte Hercílio Luz, em Florianópolis: história centenária, engenharia, clima em tempo real, acesso, estacionamento, gastronomia, serviços e atrações próximas."
  path="/"
  schema={[attractionSchema, faqSchema]}
>

  <!-- HERO -->
  <section class="relative min-h-[92vh] overflow-hidden pt-18">
    <img src="/images/ponte-hercilio-luz-hero.jpg" alt="Ponte Hercílio Luz iluminada sobre a baía em Florianópolis" class="absolute inset-0 h-full w-full object-cover" width="1920" height="1200" decoding="async" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,8,13,.96)_0%,rgba(2,8,13,.72)_42%,rgba(2,8,13,.2)_75%),linear-gradient(0deg,#02080d_0%,transparent_45%)]"></div>
    <div class="absolute inset-0 grid-lines opacity-40"></div>
    <div class="container-shell relative flex min-h-[calc(92vh-4.5rem)] items-end pb-18 pt-24 lg:items-center lg:pb-12">
      <div class="max-w-3xl">
        <h1 class="mt-5 font-[Georgia] text-[clamp(3.4rem,9vw,7.8rem)] leading-[.82] tracking-[-.06em] text-white">Ponte<br/><span class="text-[#dfa164]">Hercílio Luz</span><span class="mt-7 block font-sans text-xs font-bold uppercase leading-none tracking-[.34em] text-[#e3a86f] md:text-sm">Florianópolis · Santa Catarina · Brasil</span></h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-200 md:text-xl">Uma travessia de aço entre ilha e continente — patrimônio, engenharia e memória urbana no cartão-postal mais reconhecível de Florianópolis.</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-200">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-black/25 px-4 py-1.5"><span aria-hidden="true" class="text-[#f0b26b]">★</span><strong class="text-white">4,8</strong><span aria-hidden="true">·</span><span>24.497 avaliações no Google Maps</span></span>
          <span class="inline-flex items-center rounded-full border border-white/15 bg-black/25 px-4 py-1.5 text-xs uppercase tracking-[.14em]">Acesso público e gratuito</span>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#visita" class="rounded-full bg-[#d68b46] px-6 py-3 text-sm font-bold text-[#07141d] no-underline hover:bg-[#e6a66c]">Planejar a visita</a>
          <a href="#clima" class="rounded-full border border-white/20 bg-black/20 px-6 py-3 text-sm font-bold text-white no-underline hover:border-[#d68b46] hover:text-[#efbd8d]">Ver clima e previsão</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAIXA DE NÚMEROS -->
  <section class="border-y border-white/10 bg-[#081721] py-8">
    <div class="container-shell grid grid-cols-2 gap-7 md:grid-cols-4">
      {facts.map(([number, label]) => <div><div class="font-[Georgia] text-3xl text-white md:text-4xl">{number}</div><div class="mt-1 text-xs uppercase tracking-[.14em] text-slate-400">{label}</div></div>)}
    </div>
  </section>

  <!-- VISÃO GERAL / SOBRE (semântica geográfica do ponto turístico) -->
  <section id="sobre" class="border-b border-white/10 bg-[#07141d] py-20">
    <div class="container-shell grid gap-10 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
      <div>
        <nav aria-label="Rastro geográfico" class="text-xs font-medium uppercase tracking-[.16em] text-slate-500">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li>Ponte Hercílio Luz</li>
            <li aria-hidden="true">/</li>
            <li>Florianópolis</li>
            <li aria-hidden="true">/</li>
            <li>Santa Catarina</li>
            <li aria-hidden="true">/</li>
            <li>Brasil</li>
          </ol>
        </nav>
        <h2 class="mt-6 font-[Georgia] text-4xl leading-tight text-white md:text-5xl">Sobre a Ponte Hercílio Luz, em Florianópolis</h2>
        <p class="mt-6 leading-8 text-slate-300">A <strong class="text-white">Ponte Hercílio Luz</strong> — também conhecida como <strong class="text-white">Ponte pênsil Hercílio Luz</strong> — é a ponte pênsil mais famosa do Brasil e liga a Ilha de Santa Catarina ao continente no <strong class="text-white">Centro de Florianópolis</strong>, capital de <strong class="text-white">Santa Catarina</strong>, no sul do <strong class="text-white">Brasil</strong>. Inaugurada em 1926, é patrimônio cultural tombado nas esferas municipal, estadual e federal.</p>
        <p class="mt-5 leading-8 text-slate-400">Quem visita a ponte encontra, a poucos minutos a pé, os principais marcos do Centro Histórico — como a <strong class="text-white">Praça XV de Novembro</strong> e o <strong class="text-white">Mercado Público</strong> — além do <strong class="text-white">Parque da Luz</strong>, na cabeceira insular, e do <strong class="text-white">Forte Santana</strong>, na orla do lado continental.</p>
      </div>
      <dl class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-black/15 p-5"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Avaliação no Google</dt><dd class="mt-2 text-lg text-white">4,8 <span aria-hidden="true" class="text-[#f0b26b]">★</span> <span class="text-sm text-slate-400">(24.497)</span></dd></div>
        <div class="rounded-2xl border border-white/10 bg-black/15 p-5"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Acesso</dt><dd class="mt-2 text-lg text-white">Público e gratuito</dd></div>
        <div class="rounded-2xl border border-white/10 bg-black/15 p-5"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Endereço</dt><dd class="mt-2 text-base leading-6 text-slate-300">Ponte pênsil – Centro, Florianópolis – SC, 88010-400, Brasil</dd></div>
        <div class="rounded-2xl border border-white/10 bg-black/15 p-5"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Categoria</dt><dd class="mt-2 text-lg text-white">Ponte pênsil · patrimônio</dd></div>
      </dl>
    </div>
  </section>

  <!-- HISTÓRIA -->
  <section id="historia" class="relative overflow-hidden py-24">
    <div class="container-shell grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="eyebrow">Um século sobre a baía</p>
        <h2 class="mt-4 font-[Georgia] text-4xl leading-tight text-white md:text-6xl">A ponte que mudou a escala da capital catarinense.</h2>
        <p class="mt-7 text-base leading-8 text-slate-300">A construção começou em 1922 e a inauguração ocorreu em 13 de maio de 1926. A ligação permanente substituiu a dependência das travessias por embarcação e reorganizou a relação entre a Ilha de Santa Catarina e o continente.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">Depois de longos períodos de interdição e uma restauração estrutural complexa, a ponte foi reaberta em dezembro de 2019. Em 2026, completou cem anos como patrimônio cultural e peça viva da mobilidade e da paisagem de Florianópolis.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">Entre 1926 e 1975, ela foi a única ligação rodoviária entre a ilha e o continente — e hoje segue sendo a mais famosa. Sua história mistura política, engenharia e resiliência: idealizada durante o governo de Hercílio Luz, atravessou crises, interdições e uma restauração que a devolveu à cidade cem anos depois do início das obras.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">A travessia chegou a ser cobrada entre 1926 e 1935, e o financiamento americano usado na construção só foi totalmente quitado em 1978. Reconhecida como patrimônio em três esferas — municipal (1992), estadual (1997) e federal, pelo Iphan (1998) —, a ponte é um dos monumentos mais protegidos e mais queridos do estado.</p>
        <div class="mt-8 flex flex-wrap gap-3 text-sm">
          <a href="https://www.gov.br/iphan/pt-br/assuntos/noticias/ponte-hercilio-luz-chega-aos-100-anos-como-simbolo-de-santa-catarina" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-[#d68b46]">Iphan · centenário ↗</a>
          <a href="https://redeplanejamento.pmf.sc.gov.br/pt-BR/projetos/ponte-viva" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-[#d68b46]">Prefeitura · Ponte Viva ↗</a>
          <a href="https://www.sc.gov.br/vivaaponte/linha-do-tempo/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-[#d68b46]">Governo de SC · linha do tempo ↗</a>
        </div>
      </div>
      <figure class="panel overflow-hidden rounded-[2rem]">
        <img src="/images/ponte-hercilio-luz-estrutura.jpg" alt="Estrutura metálica e torres da Ponte Hercílio Luz" class="aspect-[4/3] w-full object-cover" width="1600" height="1200" loading="lazy" decoding="async" />
        <figcaption class="border-t border-white/10 px-6 py-4 text-xs leading-5 text-slate-400">Torres, treliças e barras de olhal formam a linguagem estrutural que faz da ponte uma obra singular da engenharia do início do século XX.</figcaption>
      </figure>
    </div>
    <div class="container-shell">
      <p class="eyebrow mt-20">Linha do tempo</p>
      <h3 class="mt-3 font-[Georgia] text-3xl text-white md:text-4xl">Do projeto ao centenário</h3>
      <ol class="mt-9 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {timeline.map(([year, text]) => (
          <li class="relative border-l border-white/10 pl-5">
            <span class="absolute -left-1 top-1.5 h-2.5 w-2.5 rounded-full bg-[#d68b46]"></span>
            <div class="font-[Georgia] text-xl text-[#e3a86f]">{year}</div>
            <p class="mt-1 text-sm leading-6 text-slate-400">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ENGENHARIA -->
  <section id="engenharia" class="border-y border-white/10 bg-[#0b1d29] py-24">
    <div class="container-shell grid gap-12 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="eyebrow">Engenharia e restauro</p>
        <h2 class="mt-4 font-[Georgia] text-4xl leading-tight text-white md:text-6xl">Como uma ponte de barras de olhal atravessou um século</h2>
        <p class="mt-7 text-base leading-8 text-slate-300">Encomendada no início da década de 1920, a obra foi projetada pela firma americana <strong class="text-white">Robinson &amp; Steinman</strong> — com participação de David B. Steinman — e erguida pela American Bridge Company, com aço e componentes trazidos dos Estados Unidos. As obras começaram em 14 de novembro de 1922 e a inauguração ocorreu em 13 de maio de 1926.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">Ao contrário dos cabos de aço comuns nas pontes pênsiles atuais, a Hercílio Luz é sustentada por <strong class="text-white">cadeias de barras de olhal</strong> (eye-bars) que atravessam torres de cerca de 74 m e distribuem o peso do vão central de 339,5 m. Com cerca de 5.000 toneladas de aço, é a maior ponte pênsil do Brasil e um dos maiores exemplos de ponte suspensa por barras de olhal ainda em uso no mundo.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">A estrutura envelheceu e exigiu decisões difíceis. Após fissuras detectadas em 1981, a ponte foi interditada para veículos em 1982, reaberta parcialmente a pedestres e ciclistas em 1988 e fechada novamente em 1991, quando o asfalto foi removido para aliviar peso. No grande restauro concluído em 2019, o tabuleiro ganhou grelha metálica, a cadeia de suspensão foi renovada e o vão chegou a ser erguido com macacos hidráulicos para a troca de componentes — um trabalho de precisão centimétrica sobre uma obra tombada.</p>
      </div>
