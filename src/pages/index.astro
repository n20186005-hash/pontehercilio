---
import BaseLayout from '../layouts/BaseLayout.astro';

const facts = [
  ['821 m', 'extensão aproximada'],
  ['339,5 m', 'vão central pênsil'],
  ['1926', 'ano de inauguração'],
  ['2019', 'reabertura após restauração'],
];
const faq = [
  { q: 'A Ponte Hercílio Luz é paga?', a: 'Não há cobrança de ingresso para caminhar e apreciar a ponte como espaço público. Serviços privados no entorno, estacionamento e transporte têm tarifas próprias.' },
  { q: 'Qual é o melhor horário para visitar?', a: 'O fim da tarde combina luz favorável para fotografia com a transição para a iluminação cênica. Em fins de semana e feriados, a experiência costuma ser mais voltada a pedestres e ciclistas, mas alterações temporárias podem ocorrer.' },
  { q: 'Quanto tempo reservar?', a: 'Para atravessar com calma, fotografar e visitar o Parque da Luz, reserve aproximadamente 1 a 2 horas. Um roteiro com Mercado Público e Centro Histórico pode ocupar meio período.' },
  { q: 'É possível atravessar de bicicleta?', a: 'Sim, há circulação de ciclistas, sujeita à sinalização e a eventuais restrições operacionais em eventos ou manutenção.' },
  { q: 'Carros podem passar pela ponte?', a: 'Nos dias úteis há circulação veicular conforme as regras operacionais vigentes. Fins de semana e feriados tradicionalmente privilegiam pedestres e ciclistas. Consulte avisos do Governo de Santa Catarina antes da viagem, pois eventos e manutenção podem alterar o fluxo.' },
  { q: 'Onde conseguir as melhores fotos?', a: 'O Parque da Luz e o mirante da cabeceira insular oferecem enquadramentos frontais; a orla e o entorno do Forte Santana ajudam a registrar a estrutura por baixo e em perspectiva lateral.' },
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: 'Ponte Hercílio Luz',
  alternateName: 'Ponte pênsil Hercílio Luz',
  description: 'Ponte pênsil histórica de Florianópolis, símbolo de Santa Catarina e patrimônio cultural brasileiro.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ponte pênsil - Centro',
    addressLocality: 'Florianópolis',
    addressRegion: 'SC',
    postalCode: '88010-400',
    addressCountry: 'BR'
  },
  geo: { '@type': 'GeoCoordinates', latitude: -27.593811676247984, longitude: -48.56768502278584 },
  openingHours: 'Acesso para visitação e travessia de pedestres sujeito às regras operacionais e a interdições temporárias; consulte os canais oficiais antes da visita.',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.8', reviewCount: '24497', bestRating: '5' },
  isAccessibleForFree: true,
  sameAs: [
    'https://www.gov.br/iphan/pt-br/assuntos/noticias/ponte-hercilio-luz-chega-aos-100-anos-como-simbolo-de-santa-catarina',
    'https://www.sc.gov.br/vivaaponte/',
    'https://redeplanejamento.pmf.sc.gov.br/pt-BR/projetos/ponte-viva'
  ],
  ...(Astro.site ? { url: new URL('/', Astro.site).toString(), image: new URL('/images/ponte-hercilio-luz-hero.jpg', Astro.site).toString() } : {})
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({q, a}) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};
---
<BaseLayout
  title="Ponte Hercílio Luz | História, visita e guia de Florianópolis"
  description="Guia independente em português sobre a Ponte Hercílio Luz, em Florianópolis: história, acesso, melhores horários, estacionamento, transporte, gastronomia e atrações próximas."
  path="/"
  schema={[attractionSchema, faqSchema]}
>
  <section class="relative min-h-[92vh] overflow-hidden pt-18">
    <img src="/images/ponte-hercilio-luz-hero.jpg" alt="Ponte Hercílio Luz iluminada sobre a baía em Florianópolis" class="absolute inset-0 h-full w-full object-cover" width="1600" height="1000" fetchpriority="high" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,8,13,.96)_0%,rgba(2,8,13,.72)_42%,rgba(2,8,13,.2)_75%),linear-gradient(0deg,#02080d_0%,transparent_45%)]"></div>
    <div class="absolute inset-0 grid-lines opacity-40"></div>
    <div class="container-shell relative flex min-h-[calc(92vh-4.5rem)] items-end pb-18 pt-24 lg:items-center lg:pb-12">
      <div class="max-w-3xl">
        <p class="eyebrow">Florianópolis · Santa Catarina · Brasil</p>
        <h1 class="mt-5 font-[Georgia] text-[clamp(3.4rem,9vw,7.8rem)] leading-[.82] tracking-[-.06em] text-white">Ponte<br/><span class="text-[#dfa164]">Hercílio Luz</span></h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-200 md:text-xl">Uma travessia de aço entre ilha e continente — patrimônio, engenharia e memória urbana no cartão-postal mais reconhecível de Florianópolis.</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#visita" class="rounded-full bg-[#d68b46] px-6 py-3 text-sm font-bold text-[#07141d] no-underline hover:bg-[#e6a66c]">Planejar a visita</a>
          <span class="rounded-full border border-white/20 bg-black/20 px-4 py-3 text-sm text-white"><strong>4,8</strong> · 24.497 avaliações informadas</span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#081721] py-8">
    <div class="container-shell grid grid-cols-2 gap-7 md:grid-cols-4">
      {facts.map(([number, label]) => <div><div class="font-[Georgia] text-3xl text-white md:text-4xl">{number}</div><div class="mt-1 text-xs uppercase tracking-[.14em] text-slate-400">{label}</div></div>)}
    </div>
  </section>

  <section id="historia" class="relative overflow-hidden py-24">
    <div class="container-shell grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="eyebrow">Um século sobre a baía</p>
        <h2 class="mt-4 font-[Georgia] text-4xl leading-tight text-white md:text-6xl">A ponte que mudou a escala da capital catarinense.</h2>
        <p class="mt-7 text-base leading-8 text-slate-300">A construção começou em 1922 e a inauguração ocorreu em 13 de maio de 1926. A ligação permanente substituiu a dependência das travessias por embarcação e reorganizou a relação entre a Ilha de Santa Catarina e o continente.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">Depois de longos períodos de interdição e uma restauração estrutural complexa, a ponte foi reaberta em dezembro de 2019. Em 2026, completou cem anos como patrimônio cultural e peça viva da mobilidade e da paisagem de Florianópolis.</p>
        <div class="mt-8 flex flex-wrap gap-3 text-sm">
          <a href="https://www.gov.br/iphan/pt-br/assuntos/noticias/ponte-hercilio-luz-chega-aos-100-anos-como-simbolo-de-santa-catarina" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-[#d68b46]">Iphan · centenário ↗</a>
          <a href="https://redeplanejamento.pmf.sc.gov.br/pt-BR/projetos/ponte-viva" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-[#d68b46]">Prefeitura · Ponte Viva ↗</a>
          <a href="https://www.sc.gov.br/vivaaponte/linha-do-tempo/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-[#d68b46]">Governo de SC · linha do tempo ↗</a>
        </div>
      </div>
      <figure class="panel overflow-hidden rounded-[2rem]">
        <img src="/images/ponte-hercilio-luz-estrutura.jpg" alt="Estrutura metálica e torres da Ponte Hercílio Luz" class="aspect-[4/3] w-full object-cover" width="1200" height="900" loading="lazy" />
        <figcaption class="border-t border-white/10 px-6 py-4 text-xs leading-5 text-slate-400">Torres, treliças e barras de olhal formam a linguagem estrutural que faz da ponte uma obra singular da engenharia do início do século XX.</figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-[#07141d] py-24">
    <div class="container-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Engenharia em leitura rápida</p>
        <h2 class="mt-4 font-[Georgia] text-4xl text-white md:text-5xl">O que observar quando estiver sobre ela</h2>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <article class="panel rounded-3xl p-7"><div class="text-5xl text-[#d68b46]">01</div><h3 class="mt-5 text-xl font-semibold text-white">O vão pênsil</h3><p class="mt-3 leading-7 text-slate-400">O trecho central suspenso se estende por cerca de 339,5 m. Observe a curva das correntes e a repetição das barras verticais sobre a água.</p></article>
        <article class="panel rounded-3xl p-7"><div class="text-5xl text-[#d68b46]">02</div><h3 class="mt-5 text-xl font-semibold text-white">As torres</h3><p class="mt-3 leading-7 text-slate-400">As torres principais atingem aproximadamente 75 m a partir do nível do mar e organizam a silhueta que define o horizonte da baía.</p></article>
        <article class="panel rounded-3xl p-7"><div class="text-5xl text-[#d68b46]">03</div><h3 class="mt-5 text-xl font-semibold text-white">A restauração</h3><p class="mt-3 leading-7 text-slate-400">A reabilitação preservou a lógica histórica da estrutura e substituiu componentes críticos, permitindo a reabertura após décadas de interdição.</p></article>
      </div>
    </div>
  </section>

  <section id="visita" class="py-24">
    <div class="container-shell">
      <p class="eyebrow">Informação prática</p>
      <h2 class="mt-4 max-w-3xl font-[Georgia] text-4xl text-white md:text-6xl">Como visitar sem perder o melhor da ponte</h2>
      <div class="mt-12 grid gap-5 lg:grid-cols-2">
        <article class="panel rounded-3xl p-7"><h3 class="text-xl font-semibold text-white">Entrada e custos</h3><p class="mt-3 leading-7 text-slate-400">A visita e a travessia a pé são gratuitas. Não há bilheteria. Gastos ficam por conta de transporte, estacionamento e consumo em estabelecimentos do entorno.</p></article>
        <article class="panel rounded-3xl p-7"><h3 class="text-xl font-semibold text-white">Melhor período e duração</h3><p class="mt-3 leading-7 text-slate-400">Fim de tarde e começo da noite oferecem a melhor transição visual: luz baixa, pôr do sol e iluminação cênica. Reserve de 1 a 2 horas para ponte + Parque da Luz.</p></article>
        <article class="panel rounded-3xl p-7"><h3 class="text-xl font-semibold text-white">Circulação e horários</h3><p class="mt-3 leading-7 text-slate-400">Pedestres e ciclistas dispõem de passarelas, enquanto o tráfego de veículos segue regras próprias. Fins de semana e feriados costumam priorizar o uso não motorizado. Eventos e manutenção podem alterar o fluxo: verifique avisos oficiais antes de sair.</p></article>
        <article class="panel rounded-3xl p-7"><h3 class="text-xl font-semibold text-white">Acessibilidade e clima</h3><p class="mt-3 leading-7 text-slate-400">A travessia é longa e exposta a vento, sol e chuva. Use calçado confortável e proteção solar. Pessoas com mobilidade reduzida devem avaliar o percurso e as condições dos acessos no dia.</p></article>
      </div>
    </div>
  </section>

  <section class="bg-[#e8e1d7] py-24 text-[#07141d]">
    <div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-[#a55e23]">Transporte detalhado</p>
        <h2 class="mt-4 font-[Georgia] text-4xl md:text-5xl">Chegue pelo Centro e transforme o deslocamento em passeio.</h2>
        <p class="mt-6 leading-8 text-[#3e4d55]">A cabeceira insular fica junto ao Parque da Luz e próxima ao eixo da Rua Felipe Schmidt. É uma área bem conectada ao Centro, ao terminal urbano e ao corredor da Beira-Mar.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-3xl border border-[#07141d]/10 bg-white/55 p-6"><strong>Ônibus</strong><p class="mt-2 text-sm leading-6 text-[#4d5b63]">Use linhas com destino ao Centro/TICEN e complete o percurso a pé. Consulte o sistema municipal para a linha mais adequada ao ponto de partida.</p></div>
        <div class="rounded-3xl border border-[#07141d]/10 bg-white/55 p-6"><strong>A pé</strong><p class="mt-2 text-sm leading-6 text-[#4d5b63]">Do Centro Histórico, combine Mercado Público, Rua Felipe Schmidt, Parque da Luz e a cabeceira da ponte em um mesmo roteiro urbano.</p></div>
        <div class="rounded-3xl border border-[#07141d]/10 bg-white/55 p-6"><strong>Bicicleta</strong><p class="mt-2 text-sm leading-6 text-[#4d5b63]">A orla e os acessos centrais permitem integrar a ponte a um trajeto ciclável. Respeite a sinalização e a prioridade de pedestres.</p></div>
        <div class="rounded-3xl border border-[#07141d]/10 bg-white/55 p-6"><strong>Carro e aplicativo</strong><p class="mt-2 text-sm leading-6 text-[#4d5b63]">Para visita turística, é mais simples estacionar no Centro e seguir a pé. Em fins de semana, o regime de circulação sobre a ponte pode restringir veículos.</p></div>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-shell grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="map-frame h-[520px] overflow-hidden rounded-[2rem] border border-white/10 bg-[#0b1d29]">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6289.275484598642!2d-48.56768502278584!3d-27.593811676247984!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x952737f3a902cdc7%3A0x1aa7dec706ee183a!2sPonte%20Herc%C3%ADlio%20Luz!5e1!3m2!1spt-BR!2sbr!4v1788345404308!5m2!1spt-BR!2sbr" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="Mapa da Ponte Hercílio Luz em Florianópolis"></iframe>
      </div>
      <div>
        <p class="eyebrow">Localização</p>
        <h2 class="mt-4 font-[Georgia] text-4xl text-white md:text-5xl">Ponte pênsil — Centro, Florianópolis</h2>
        <dl class="mt-8 space-y-5 text-sm">
          <div><dt class="text-slate-500">Endereço de referência</dt><dd class="mt-1 text-lg text-white">Ponte pênsil - Centro, Florianópolis - SC, 88010-400, Brasil</dd></div>
          <div><dt class="text-slate-500">Plus Code</dt><dd class="mt-1 text-lg text-white">CC4M+FX Centro, Florianópolis - SC</dd></div>
          <div><dt class="text-slate-500">Coordenadas usadas neste guia</dt><dd class="mt-1 text-lg text-white">-27.5938117, -48.5676850</dd></div>
        </dl>
        <a href="https://maps.app.goo.gl/NTxFSZTyTbenYDZo6" target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-bold text-[#07141d] no-underline">Abrir no Google Maps ↗</a>
      </div>
    </div>
  </section>

  <section class="bg-[#07141d] py-24">
    <div class="container-shell grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Estacionamento</p>
        <h2 class="mt-4 font-[Georgia] text-4xl text-white md:text-5xl">Evite procurar vaga na cabeceira.</h2>
        <p class="mt-6 leading-8 text-slate-400">O entorno imediato é turístico e urbano, com oferta limitada na rua. Prefira estacionamentos privados no Centro e caminhe os últimos minutos. O Top Market, a cerca de 300 m da ponte, divulga estacionamento rotativo coberto com acesso pela Rua Conselheiro Mafra.</p>
        <p class="mt-4 text-sm leading-6 text-slate-500">Tarifas e disponibilidade mudam; confirme no estabelecimento antes de estacionar. Este guia não mantém parceria comercial.</p>
      </div>
      <img src="/images/ponte-hercilio-luz-passarela.jpg" alt="Passarela e estrutura da Ponte Hercílio Luz" class="aspect-[16/9] w-full rounded-[2rem] object-cover" width="1200" height="675" loading="lazy" />
    </div>
  </section>

  <section id="entorno" class="py-24">
    <div class="container-shell">
      <p class="eyebrow">Entorno a pé</p>
      <h2 class="mt-4 font-[Georgia] text-4xl text-white md:text-6xl">Continue o roteiro sem sair do Centro</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <article class="panel rounded-3xl p-7"><span class="text-xs uppercase tracking-[.18em] text-[#d68b46]">Vista e parque</span><h3 class="mt-3 text-xl font-semibold text-white">Parque da Luz</h3><p class="mt-3 leading-7 text-slate-400">Área verde na cabeceira insular, com mirantes para a ponte e boa parada para descanso antes ou depois da travessia.</p></article>
        <article class="panel rounded-3xl p-7"><span class="text-xs uppercase tracking-[.18em] text-[#d68b46]">Patrimônio</span><h3 class="mt-3 text-xl font-semibold text-white">Forte Santana do Estreito</h3><p class="mt-3 leading-7 text-slate-400">Fortificação histórica próxima à ponte, restaurada com espaço de contemplação que enquadra a estrutura a partir da orla.</p></article>
        <article class="panel rounded-3xl p-7"><span class="text-xs uppercase tracking-[.18em] text-[#d68b46]">Centro histórico</span><h3 class="mt-3 text-xl font-semibold text-white">Mercado Público</h3><p class="mt-3 leading-7 text-slate-400">Mercado tradicional do Centro, útil para combinar patrimônio urbano, produtos locais e uma pausa gastronômica no mesmo passeio.</p></article>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#0b1d29] py-24">
    <div class="container-shell">
      <div class="grid gap-9 lg:grid-cols-[.7fr_1.3fr]">
        <div><p class="eyebrow">Comer por perto</p><h2 class="mt-4 font-[Georgia] text-4xl text-white md:text-5xl">Gastronomia com a ponte no horizonte</h2><p class="mt-5 leading-7 text-slate-400">As sugestões abaixo são referências de localização e estilo, sem patrocínio. Confira horários e reservas diretamente com cada casa.</p></div>
        <div class="grid gap-4 sm:grid-cols-2">
          <article class="rounded-3xl border border-white/10 bg-black/15 p-6"><h3 class="text-lg font-semibold text-white">Artesania Choripanes e Parrilla</h3><p class="mt-2 text-sm leading-6 text-slate-400">Parrilla de inspiração pampeana na Rua Felipe Schmidt, perto do Parque da Luz.</p></article>
          <article class="rounded-3xl border border-white/10 bg-black/15 p-6"><h3 class="text-lg font-semibold text-white">Píer 54</h3><p class="mt-2 text-sm leading-6 text-slate-400">Frutos do mar e cozinha brasileira junto à água, com a Ponte Hercílio Luz como parte do cenário.</p></article>
          <article class="rounded-3xl border border-white/10 bg-black/15 p-6"><h3 class="text-lg font-semibold text-white">Armazém Rita Maria</h3><p class="mt-2 text-sm leading-6 text-slate-400">Complexo restaurado com diferentes operações gastronômicas a poucos minutos da cabeceira insular.</p></article>
          <article class="rounded-3xl border border-white/10 bg-black/15 p-6"><h3 class="text-lg font-semibold text-white">Mercado Público de Florianópolis</h3><p class="mt-2 text-sm leading-6 text-slate-400">Para petiscos, frutos do mar e sabores ligados ao cotidiano do Centro Histórico.</p></article>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-shell">
      <div class="grid gap-4 md:grid-cols-12 md:grid-rows-2">
        <img src="/images/ponte-hercilio-luz-panorama.jpg" alt="Vista panorâmica da Ponte Hercílio Luz" class="min-h-72 w-full rounded-3xl object-cover md:col-span-7 md:row-span-2 md:h-full" width="1200" height="900" loading="lazy" />
        <img src="/images/ponte-hercilio-luz-noite.jpg" alt="Ponte Hercílio Luz iluminada à noite" class="min-h-64 w-full rounded-3xl object-cover md:col-span-5" width="900" height="600" loading="lazy" />
        <img src="/images/ponte-hercilio-luz-detalhe.jpg" alt="Detalhe da estrutura metálica da Ponte Hercílio Luz" class="min-h-64 w-full rounded-3xl object-cover md:col-span-5" width="900" height="600" loading="lazy" />
      </div>
      <p class="mt-4 text-xs text-slate-500">Fotografias locais do projeto. Autoria e licenças completas em <a class="underline hover:text-white" href="/CREDITOS-IMAGENS.txt">Créditos de imagens</a>.</p>
    </div>
  </section>

  <section id="faq" class="bg-[#e8e1d7] py-24 text-[#07141d]">
    <div class="container-shell grid gap-10 lg:grid-cols-[.7fr_1.3fr]">
      <div><p class="text-xs font-bold uppercase tracking-[.18em] text-[#a55e23]">Perguntas frequentes</p><h2 class="mt-4 font-[Georgia] text-4xl md:text-5xl">FAQ da Ponte Hercílio Luz</h2></div>
      <div class="divide-y divide-[#07141d]/15 border-y border-[#07141d]/15">
        {faq.map((item) => <details class="group py-5"><summary class="cursor-pointer list-none pr-8 text-lg font-semibold">{item.q}<span class="float-right text-[#a55e23] group-open:rotate-45">+</span></summary><p class="mt-3 max-w-2xl leading-7 text-[#4d5b63]">{item.a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-shell panel overflow-hidden rounded-[2rem] p-8 md:p-12">
      <div class="bridge-line"></div>
      <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div><p class="eyebrow">Antes de sair</p><h2 class="mt-3 max-w-3xl font-[Georgia] text-3xl text-white md:text-5xl">Tráfego, eventos e manutenção podem alterar o acesso temporariamente.</h2><p class="mt-4 max-w-2xl leading-7 text-slate-400">Para decisões de viagem, priorize comunicados da Secretaria de Estado da Infraestrutura e Mobilidade de Santa Catarina e da Prefeitura de Florianópolis.</p></div>
