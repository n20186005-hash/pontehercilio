---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import { ADDRESS, ATTRACTION_NAME, CITY_NAME, GEO, MAPS_URL, SITE_NAME } from '../data/site';

const pageTitle = `${ATTRACTION_NAME} ${CITY_NAME}: horários, como chegar e história`;
const pageDescription = 'Horários, circulação e iluminação da Ponte Hercílio Luz em Florianópolis (SC): como chegar a pé, de ônibus ou de bicicleta, história centenária, mirantes e dicas de visita.';

// ---- Fatos rápidos (faixa sob o herói) ----
const facts = [
  ['821 m', 'extensão aproximada'],
  ['339,5 m', 'vão central pênsil'],
  ['1926', 'ano de inauguração'],
  ['2019', 'reabertura após restauração'],
];

// ---- Linha do tempo (História) ----
const timeline = [
  [
    "1922",
    "Obras iniciadas em 14 de novembro, segundo o Ministério Público de Contas de SC."
  ],
  [
    "1926",
    "Inauguração em 13 de maio: ligação entre a ilha e o continente."
  ],
  [
    "1998",
    "Tombamento federal pelo Iphan."
  ],
  [
    "2019",
    "Reabertura após a restauração, documentada pela SETUR."
  ],
  [
    "2026",
    "Centenário da inauguração em 13 de maio."
  ]
];

// ---- Números técnicos (Engenharia) ----
const stats = [
  [
    "cerca de 821 m",
    "extensão na referência Viva a Ponte"
  ],
  [
    "339,5 m",
    "vão central na referência Viva a Ponte"
  ],
  [
    "1926",
    "inauguração"
  ],
  [
    "2019",
    "reabertura após restauro"
  ]
];

// ---- Roteiro sugerido (Visita) ----
const roteiro = [
  "Comece pelo Centro e localize a cabeceira insular, junto ao Parque da Luz.",
  "Confira a sinalização e os avisos de operação antes de entrar na passarela.",
  "Se a passagem estiver liberada, caminhe no seu ritmo e deixe espaço para os demais usuários.",
  "Planeje o retorno, a proteção contra o tempo e eventuais paradas no Centro. A iluminação e a luz do pôr do sol não são garantidas."
];

// ---- Serviços e infraestrutura no entorno (neutro, sem indicação comercial) ----
const facilities = [
  [
    "Preparação",
    "Água e proteção",
    "Leve água e proteção adequada ao tempo. Confirme banheiros e locais de descanso antes de começar; este guia não verifica a disponibilidade desses serviços em tempo real."
  ],
  [
    "Mobilidade",
    "Acessos e percurso",
    "Consulte as condições de piso, acessos e circulação para suas necessidades. A extensão da ponte merece planejamento de ida e volta."
  ],
  [
    "Estacionamento",
    "Vagas e tarifas",
    "Verifique sinalização, disponibilidade e preço no local. Não há reserva ou indicação de estacionamento feita por este guia."
  ],
  [
    "Serviços",
    "Comércio no Centro",
    "Consulte cada estabelecimento para horários, acessibilidade e preços. Serviços e passeios vendidos por terceiros não equivalem a ingresso da ponte."
  ]
];

// ---- Histórias e curiosidades ----
const stories = [
  [
    "História",
    "Uma ligação entre ilha e continente",
    "A inauguração de 1926 marcou a ligação rodoviária entre a ilha e o continente, antes feita também por embarcações."
  ],
  [
    "Engenharia",
    "Uma ponte pênsil",
    "A cadeia de barras de olhal é parte característica do sistema de suspensão da ponte."
  ],
  [
    "Patrimônio",
    "Proteção federal",
    "O Iphan registra o tombamento federal em 1998 e o centenário em 2026."
  ],
  [
    "Restauração",
    "Retorno ao uso",
    "A SETUR registra a reabertura em 2019 após a restauração. O patrimônio continua sujeito a inspeções e manutenção."
  ]
];

const faq = [
  {
    "q": "Onde fica a Ponte Hercílio Luz?",
    "a": "Em Florianópolis, Santa Catarina, ligando a ilha ao continente. A referência de acesso pelo Centro é a cabeceira junto ao Parque da Luz."
  },
  {
    "q": "A ponte está aberta agora?",
    "a": "Este guia não monitora a liberação em tempo real. Confira avisos da SIE e da Prefeitura e a sinalização no local; veículos, pedestres e bicicletas têm condições de circulação distintas."
  },
  {
    "q": "A ponte fecha aos fins de semana?",
    "a": "O MPC-SC descreveu em julho de 2026 a proibição de veículos nos fins de semana. Isso não demonstra fechamento das passarelas. O cadastro do Google Maps consultado em 23/10/2026 mostra 24 horas de segunda a sexta e fechado no sábado e domingo; essa tabela de terceiro não confirma o acesso de pedestres."
  },
  {
    "q": "Preciso comprar ingresso ou passeio?",
    "a": "As fontes consultadas descrevem a ponte como travessia pública, sem indicar bilhete turístico para uma caminhada comum. Passeios de barco e outros produtos anunciados por terceiros são serviços separados. Este site não vende ingressos nem opera a ponte."
  },
  {
    "q": "Quanto mede a ponte?",
    "a": "A referência técnica Viva a Ponte informa cerca de 821 metros de extensão e 339,5 metros de vão central. O MPC-SC usa o arredondamento de aproximadamente 822 metros. Não confunda extensão total com vão suspenso."
  },
  {
    "q": "Quando foi inaugurada?",
    "a": "Em 13 de maio de 1926. A obra começou em 14 de novembro de 1922 e completou cem anos da inauguração em maio de 2026."
  },
  {
    "q": "Como planejar a caminhada?",
    "a": "Considere a extensão de ida e volta, seu ritmo e as condições de acesso. Leve água e proteção adequada. A previsão meteorológica não confirma interdições; siga os avisos locais."
  },
  {
    "q": "Onde confirmar as regras de circulação?",
    "a": "Consulte os comunicados da Secretaria de Estado da Infraestrutura e Mobilidade de Santa Catarina e da Prefeitura de Florianópolis antes de sair e respeite a sinalização no local."
  }
];

// ---- Guias internos (links de profundidade) ----
const guideLinks = [
  { href: '/horarios/', title: 'Horários e circulação', text: 'Quando atravessar, como funciona o acesso de veículos e em que momento a acesso deve ser confirmado.' },
  { href: '/como-chegar/', title: 'Como chegar', text: 'A pé pelo Centro, de ônibus até o TICEN, de bicicleta ou de carro — com onde estacionar e por qual cabeceira começar.' },
  { href: '/historia/', title: 'História e engenharia', text: 'De 1922 ao centenário em 2026: obras, inauguração, tombamento e restauração que devolveu a ponte à cidade.' },
];

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  name: SITE_NAME,
  url: `${siteOrigin}/`,
  inLanguage: 'pt-BR'
};

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteOrigin}/#attraction`,
  name: ATTRACTION_NAME,
  additionalType: 'https://schema.org/Bridge',
  alternateName: ['Ponte pênsil Hercílio Luz', 'Ponte Hercílio Luz de Florianópolis', 'Puente Hercílio Luz', 'Hercílio Luz Bridge'],
  description: 'Ponte pênsil histórica no Centro de Florianópolis, em Santa Catarina (Brasil): símbolo do estado, patrimônio cultural brasileiro.',
  url: `${siteOrigin}/`,
  image: [`${siteOrigin}/images/ponte-hercilio-luz-hero.jpg`],
  address: { '@type': 'PostalAddress', ...ADDRESS },
  geo: { '@type': 'GeoCoordinates', ...GEO },
  hasMap: MAPS_URL,
  sameAs: [
    'https://www.gov.br/iphan/pt-br/assuntos/noticias/ponte-hercilio-luz-chega-aos-100-anos-como-simbolo-de-santa-catarina',
    'https://www.sc.gov.br/vivaaponte/',
    'https://redeplanejamento.pmf.sc.gov.br/pt-BR/projetos/ponte-viva',
    'https://www.setur.sc.gov.br/',
    MAPS_URL
  ]
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/"
  schema={[websiteSchema, attractionSchema, faqSchema]}
>

  <!-- HERO -->
  <section class="relative min-h-[92vh] overflow-hidden pt-18">
    <img src="/images/ponte-hercilio-luz-hero.jpg" alt="Ponte Hercílio Luz iluminada sobre a baía em Florianópolis" class="absolute inset-0 h-full w-full object-cover" width="1920" height="1200" decoding="async" fetchpriority="high" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,8,13,.96)_0%,rgba(2,8,13,.72)_42%,rgba(2,8,13,.2)_75%),linear-gradient(0deg,#02080d_0%,transparent_45%)]"></div>
    <div class="absolute inset-0 grid-lines opacity-40"></div>
    <div class="container-shell relative flex min-h-[calc(92vh-4.5rem)] items-end pb-18 pt-24 lg:items-center lg:pb-12">
      <div class="max-w-3xl">
        <h1 class="mt-5 font-[Georgia] text-[clamp(3.4rem,9vw,7.8rem)] leading-[.82] tracking-[-.06em] text-white">Ponte<br/><span class="text-[#dfa164]">Hercílio Luz</span><span class="mt-7 block font-sans text-xs font-bold uppercase leading-none tracking-[.34em] text-[#e3a86f] md:text-sm">Florianópolis · Santa Catarina · Brasil</span></h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-200 md:text-xl">Uma travessia de aço entre ilha e continente — patrimônio, engenharia e memória urbana no cartão-postal mais reconhecível de Florianópolis.</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-200">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-black/25 px-4 py-1.5"><span aria-hidden="true" class="text-[#f0b26b]">★</span><strong class="text-white">4,8</strong><span aria-hidden="true">·</span><span>24.611 avaliações no Google Maps · 23/10/2026</span></span>
          <span class="inline-flex items-center rounded-full border border-white/15 bg-black/25 px-4 py-1.5 text-xs uppercase tracking-[.14em]">Travessia pública · confira a operação</span>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#visita" class="rounded-full bg-[#d68b46] px-6 py-3 text-sm font-bold text-[#07141d] no-underline hover:bg-[#e6a66c]">Planejar a visita</a>
          <a href="#clima" class="rounded-full border border-white/20 bg-black/20 px-6 py-3 text-sm font-bold text-white no-underline hover:border-[#d68b46] hover:text-[#efbd8d]">Ver clima e previsão</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAIXA DE NÚMEROS -->
  <section class="border-y border-white/10 bg-[#081721] py-8">
    <div class="container-shell grid grid-cols-2 gap-7 md:grid-cols-4">
      {facts.map(([number, label]) => <div><div class="font-[Georgia] text-3xl text-white md:text-4xl">{number}</div><div class="mt-1 text-xs uppercase tracking-[.14em] text-slate-400">{label}</div></div>)}
    </div>
  </section>

  <!-- VISÃO GERAL / SOBRE (semântica geográfica do ponto turístico) -->
  <section id="sobre" class="border-b border-white/10 bg-[#07141d] py-20">
    <div class="container-shell grid gap-10 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
      <div>
        <nav aria-label="Rastro geográfico" class="text-xs font-medium uppercase tracking-[.16em] text-slate-500">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li>Ponte Hercílio Luz</li>
            <li aria-hidden="true">/</li>
            <li>Florianópolis</li>
            <li aria-hidden="true">/</li>
            <li>Santa Catarina</li>
            <li aria-hidden="true">/</li>
            <li>Brasil</li>
          </ol>
        </nav>
        <h2 class="mt-6 font-[Georgia] text-4xl leading-tight text-white md:text-5xl">Sobre a Ponte Hercílio Luz, em Florianópolis</h2>
        <p class="mt-6 leading-8 text-slate-300">A <strong class="text-white">Ponte Hercílio Luz</strong> — também conhecida como <strong class="text-white">Ponte pênsil Hercílio Luz</strong> — liga a Ilha de Santa Catarina ao continente no <strong class="text-white">Centro de Florianópolis</strong>, capital de <strong class="text-white">Santa Catarina</strong>, no sul do <strong class="text-white">Brasil</strong>. Inaugurada em 1926, é patrimônio cultural tombado nas esferas municipal, estadual e federal.</p>
        <p class="mt-5 leading-8 text-slate-400">A visita à ponte pode ser combinada com o <strong class="text-white">Parque da Luz</strong>, na cabeceira insular, e com locais do Centro Histórico, como a <strong class="text-white">Praça XV de Novembro</strong> e o <strong class="text-white">Mercado Público</strong>. Organize o percurso conforme seu ponto de partida, ritmo e tempo disponível.</p>
      </div>
      <dl class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-black/15 p-5"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Avaliação no Google</dt><dd class="mt-2 text-lg text-white">4,8 <span aria-hidden="true" class="text-[#f0b26b]">★</span> <span class="text-sm text-slate-400">(24.611 · 23/10/2026)</span></dd></div>
        <div class="rounded-2xl border border-white/10 bg-black/15 p-5"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Acesso</dt><dd class="mt-2 text-lg text-white">Travessia pública · confira avisos</dd></div>
        <div class="rounded-2xl border border-white/10 bg-black/15 p-5"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Endereço</dt><dd class="mt-2 text-base leading-6 text-slate-300">Ponte pênsil – Centro, Florianópolis – SC, 88010-400, Brasil</dd></div>
        <div class="rounded-2xl border border-white/10 bg-black/15 p-5"><dt class="text-[11px] font-bold uppercase tracking-[.16em] text-slate-500">Categoria</dt><dd class="mt-2 text-lg text-white">Ponte pênsil · patrimônio</dd></div>
      </dl>
    </div>
  </section>

  <!-- HISTÓRIA -->
  <section id="historia" class="relative overflow-hidden py-24">
    <div class="container-shell grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="eyebrow">Um século sobre a baía</p>
        <h2 class="mt-4 font-[Georgia] text-4xl leading-tight text-white md:text-6xl">A ponte que mudou a escala da capital catarinense.</h2>
        <p class="mt-7 text-base leading-8 text-slate-300">A construção começou em 1922 e a inauguração ocorreu em 13 de maio de 1926. A ligação permanente substituiu a dependência das travessias por embarcação e reorganizou a relação entre a Ilha de Santa Catarina e o continente.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">Depois de longos períodos de interdição e uma restauração estrutural complexa, a ponte foi reaberta em dezembro de 2019. Em 2026, completou cem anos de inauguração e peça viva da mobilidade e da paisagem de Florianópolis.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">Entre 1926 e 1975, ela foi a única ligação rodoviária entre a ilha e o continente; sua história mistura política, engenharia e resiliência: idealizada durante o governo de Hercílio Luz, atravessou crises, interdições e uma restauração que a devolveu à cidade em 2019, antes do centenário da inauguração.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">O tombamento federal foi registrado pelo Iphan em 1998. Em 2026, o centenário reforçou a importância histórica da ponte para Florianópolis e Santa Catarina.</p>
        <div class="mt-8 flex flex-wrap gap-3 text-sm">
          <a href="https://www.gov.br/iphan/pt-br/assuntos/noticias/ponte-hercilio-luz-chega-aos-100-anos-como-simbolo-de-santa-catarina" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-[#d68b46]">Iphan · centenário ↗</a>
          <a href="https://redeplanejamento.pmf.sc.gov.br/pt-BR/projetos/ponte-viva" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-[#d68b46]">Prefeitura · Ponte Viva ↗</a>
          <a href="https://www.sc.gov.br/vivaaponte/linha-do-tempo/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-slate-200 hover:border-[#d68b46]">Governo de SC · linha do tempo ↗</a>
        </div>
      </div>
      <figure class="panel overflow-hidden rounded-[2rem]">
        <img src="/images/ponte-hercilio-luz-estrutura.jpg" alt="Estrutura metálica e torres da Ponte Hercílio Luz" class="aspect-[4/3] w-full object-cover" width="1600" height="1200" loading="lazy" decoding="async" />
        <figcaption class="border-t border-white/10 px-6 py-4 text-xs leading-5 text-slate-400">Torres, treliças e barras de olhal formam a linguagem estrutural que faz da ponte uma obra singular da engenharia do início do século XX.</figcaption>
      </figure>
    </div>
    <div class="container-shell">
      <p class="eyebrow mt-20">Linha do tempo</p>
      <h3 class="mt-3 font-[Georgia] text-3xl text-white md:text-4xl">Do projeto ao centenário</h3>
      <ol class="mt-9 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {timeline.map(([year, text]) => (
          <li class="relative border-l border-white/10 pl-5">
            <span class="absolute -left-1 top-1.5 h-2.5 w-2.5 rounded-full bg-[#d68b46]"></span>
            <div class="font-[Georgia] text-xl text-[#e3a86f]">{year}</div>
            <p class="mt-1 text-sm leading-6 text-slate-400">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ENGENHARIA -->
  <section id="engenharia" class="border-y border-white/10 bg-[#0b1d29] py-24">
    <div class="container-shell grid gap-12 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="eyebrow">Engenharia e restauro</p>
        <h2 class="mt-4 font-[Georgia] text-4xl leading-tight text-white md:text-6xl">Como uma ponte de barras de olhal atravessou um século</h2>
        <p class="mt-7 text-base leading-8 text-slate-300">Segundo o MPC-SC, as obras começaram em 14 de novembro de 1922 e a inauguração ocorreu em 13 de maio de 1926. O centenário da inauguração foi registrado em maio de 2026 pelo Iphan e pelo MPC-SC.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">A estrutura pênsil utiliza cadeias de barras de olhal. A referência técnica Viva a Ponte informa vão central de 339,5 m e extensão total aproximada de 821 m. O MPC-SC arredonda a extensão para cerca de 822 m.</p>
        <p class="mt-5 text-base leading-8 text-slate-300">A restauração permitiu a reabertura em 2019, conforme documenta a SETUR. A preservação de uma estrutura histórica em uso exige manutenção; a reabertura não dispensa a consulta aos avisos atuais de circulação.</p>
      </div>
      <div>
        <div class="grid gap-4 sm:grid-cols-2">
          {stats.map(([number, label]) => (
            <div class="rounded-3xl border border-white/10 bg-black/15 p-6">
              <div class="font-[Georgia] text-3xl leading-none text-[#e3a86f]">{number}</div>
              <p class="mt-3 text-xs uppercase leading-5 tracking-[.14em] text-slate-400">{label}</p>
            </div>
          ))}
        </div>
        <p class="mt-5 rounded-2xl border border-[#d68b46]/25 bg-[#d68b46]/5 px-5 py-4 text-xs leading-6 text-slate-300">Números aproximados, baseados em registros técnicos públicos. Para dados oficiais e avisos de operação, consulte as fontes indicadas ao longo da página e os canais do governo de Santa Catarina.</p>
      </div>
    </div>
  </section>

  <!-- O QUE OBSERVAR -->
  <section class="bg-[#07141d] py-24">
    <div class="container-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Engenharia em leitura rápida</p>
        <h2 class="mt-4 font-[Georgia] text-4xl text-white md:text-5xl">O que observar quando estiver sobre ela</h2>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <article class="panel rounded-3xl p-7"><div class="text-5xl text-[#d68b46]">01</div><h3 class="mt-5 text-xl font-semibold text-white">O vão pênsil</h3><p class="mt-3 leading-7 text-slate-400">O trecho central suspenso se estende por cerca de 339,5 m. Observe a curva das correntes e a repetição das barras verticais sobre a água.</p></article>
        <article class="panel rounded-3xl p-7"><div class="text-5xl text-[#d68b46]">02</div><h3 class="mt-5 text-xl font-semibold text-white">As torres</h3><p class="mt-3 leading-7 text-slate-400">As torres principais organizam a silhueta da ponte e sustentam o sistema de suspensão sobre a baía.</p></article>
        <article class="panel rounded-3xl p-7"><div class="text-5xl text-[#d68b46]">03</div><h3 class="mt-5 text-xl font-semibold text-white">A restauração</h3><p class="mt-3 leading-7 text-slate-400">A reabilitação preservou a lógica histórica da estrutura e substituiu componentes críticos, permitindo a reabertura após décadas de interdição.</p></article>
      </div>
    </div>
  </section>

  <!-- PÊNSIL x ESTAIADA -->
  <section id="pensil-estaiada" class="bg-[#07141d] py-24">
    <div class="container-shell grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="eyebrow">Pênsil ou estaiada?</p>
        <h2 class="mt-4 font-[Georgia] text-4xl leading-tight text-white md:text-5xl">A Ponte Hercílio Luz é pênsil — e não estaiada</h2>
        <p class="mt-7 text-base leading-8 text-slate-300">Quem busca a <strong class="text-white">"ponte estaiada de Florianópolis"</strong> geralmente está procurando justamente esta ponte. A diferença entre os dois tipos está em como o tabuleiro é sustentado:</p>
        <ul class="mt-6 space-y-4 text-sm leading-7 text-slate-400">
          <li><strong class="text-white">Ponte pênsil (Hercílio Luz):</strong> as cadeias principais passam sobre as torres e descem em curva até as ancoragens nas extremidades; o tabuleiro fica pendurado nelas por barras verticais. Aqui essas cadeias são de barras de olhal, o que torna a obra rara no mundo.</li>
          <li><strong class="text-white">Ponte estaiada:</strong> os cabos saem diretamente das torres em leque e sustentam o tabuleiro em vários pontos, sem a grande curva de suspensão. Esse é um sistema diferente do utilizado nesta ponte.</li>
        </ul>
        <p class="mt-6 text-base leading-8 text-slate-300">Na prática: se o destino é o cartão-postal do Centro, com sistema de barras de olhal e vão central de 339,5 m, você quer a ponte <strong class="text-white">pênsil</strong> — a Ponte Hercílio Luz.</p>
      </div>
      <figure class="panel overflow-hidden rounded-[2rem]">
        <img src="/images/ponte-hercilio-luz-detalhe.jpg" alt="Silhueta histórica da Ponte Hercílio Luz ao entardecer, por Fernanda Nucci" class="aspect-[4/3] w-full object-cover" width="1600" height="1200" loading="lazy" decoding="async" />
        <figcaption class="border-t border-white/10 px-6 py-4 text-xs leading-5 text-slate-400">Barras de olhal: o sistema de suspensão que distingue a Hercílio Luz de uma ponte estaiada.</figcaption>
      </figure>
    </div>
  </section>

  <!-- VISITA -->
  <section id="visita" class="py-24">
    <div class="container-shell">
      <p class="eyebrow">Informação prática</p>
      <h2 class="mt-4 max-w-3xl font-[Georgia] text-4xl text-white md:text-6xl">Como visitar sem perder o melhor da ponte</h2>
      <div class="mt-12 grid gap-5 lg:grid-cols-2">
        <article class="panel rounded-3xl p-7"><h3 class="text-xl font-semibold text-white">Entrada e custos</h3><p class="mt-3 leading-7 text-slate-400">As fontes consultadas não indicam ingresso turístico para uma caminhada comum. Gastos ficam por conta de transporte, estacionamento e consumo em estabelecimentos do entorno.</p></article>
        <article class="panel rounded-3xl p-7"><h3 class="text-xl font-semibold text-white">Melhor período e duração</h3><p class="mt-3 leading-7 text-slate-400">Escolha a luz de sua preferência e planeje a ida e a volta de acordo com seu ritmo. O funcionamento da iluminação e a circulação devem ser confirmados no dia.</p></article>
        <article class="panel rounded-3xl p-7"><h3 class="text-xl font-semibold text-white">Circulação e horários</h3><p class="mt-3 leading-7 text-slate-400">Pedestres e ciclistas dispõem de passarelas, enquanto o tráfego de veículos segue regras próprias. Fins de semana e feriados costumam priorizar o uso não motorizado. Eventos e manutenção podem alterar o fluxo: verifique avisos oficiais antes de sair.</p></article>
        <article class="panel rounded-3xl p-7"><h3 class="text-xl font-semibold text-white">Acessibilidade e clima</h3><p class="mt-3 leading-7 text-slate-400">A travessia é longa e exposta a vento, sol e chuva. Use calçado confortável e proteção solar. Pessoas com mobilidade reduzida devem avaliar o percurso e as condições dos acessos no dia.</p></article>
      </div>

      <div class="mt-12 rounded-[2rem] border border-white/10 bg-gradient-to-br from-[#0b1d29] to-[#07141d] p-7 md:p-10">
        <p class="eyebrow">Roteiro sugerido</p>
        <h3 class="mt-3 font-[Georgia] text-2xl text-white md:text-3xl">Uma tarde em torno da ponte, passo a passo</h3>
        <ol class="mt-7 grid gap-5 md:grid-cols-2">
          {roteiro.map((step, i) => (
            <li class="flex gap-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#d68b46]/50 text-sm font-bold text-[#e3a86f]">{i + 1}</span>
